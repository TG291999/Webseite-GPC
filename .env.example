# Umgebungsvariablen der GPC-Website.
# Vorlage — echte Werte gehören in .env.local (lokal) bzw. in Vercel unter
# Settings → Environment Variables. Niemals echte Schlüssel in dieses File.

# --- Prozess-Check: Lead-Zustellung ------------------------------------------
# Ohne RESEND_API_KEY landet ein Lead nur im Server-Log, es geht keine Mail raus.
RESEND_API_KEY=
# Optional. Ohne verifizierte Absenderdomain nutzt Resend seinen Testabsender.
RESEND_FROM="Prozess-Check <prozess-check@goebel-partner.de>"
# Optional: zusätzliche Weitergabe des Leads an Make.com (z. B. für Close).
MAKE_WEBHOOK_URL=

# --- Prozess-Check: Funnel-Messung -------------------------------------------
# Ohne diese beiden Variablen schreibt /api/prozess-check/ereignis nur ins
# Vercel-Log. Das reicht für denselben Tag, aber nicht länger: Vercel hält
# Runtime-Logs nur kurz vor (Hobby ~1 Stunde, Pro 1–3 Tage).
#
# Sind beide gesetzt, wird jedes Ereignis zusätzlich dauerhaft in Supabase
# geschrieben. Tabelle vorher anlegen: supabase/prozess-check-events.sql
#
# Beide Werte im Supabase-Dashboard des Projekts "GPC Prozess" unter
#   Project Settings → API
# FUNNEL_SUPABASE_URL  = "Project URL"
# FUNNEL_SUPABASE_KEY  = "service_role"-Key (NICHT der anon-Key, NICHT das
#                        Datenbank-Passwort). Der Key umgeht RLS und darf
#                        ausschließlich serverseitig gesetzt sein — niemals mit
#                        NEXT_PUBLIC_ Präfix, sonst steht er im Browser.
FUNNEL_SUPABASE_URL=
FUNNEL_SUPABASE_KEY=
